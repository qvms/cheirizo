{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 2,
  "modules-left": [
    "custom/launcher",
    "custom/files",
    "custom/terminal",
    "wlr/taskbar"
  ],
  "modules-right": [
    "tray",
    "clock",
    "custom/session"
  ],
  "custom/launcher": {
    "format": "◆",
    "tooltip-format": "Applications and session actions",
    "on-click": "/usr/lib/wrdp/wrdp-desktop-action launcher"
  },
  "custom/files": {
    "format": "Files",
    "tooltip-format": "Open Thunar",
    "on-click": "/usr/lib/wrdp/wrdp-desktop-action files"
  },
  "custom/terminal": {
    "format": "Terminal",
    "tooltip-format": "Open Foot",
    "on-click": "/usr/lib/wrdp/wrdp-desktop-action terminal"
  },
  "wlr/taskbar": {
    "format": "{icon} {title}",
    "icon-size": 16,
    "tooltip-format": "{app_id}: {title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["waybar"]
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S %Z}"
  },
  "custom/session": {
    "format": "Session",
    "tooltip-format": "Reconfigure or disconnect",
    "on-click": "/usr/lib/wrdp/wrdp-desktop-action session"
  }
}
