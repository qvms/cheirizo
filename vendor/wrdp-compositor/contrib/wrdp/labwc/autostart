# WRDP minimal managed desktop. Geometry is owned by the authenticated RDP
# binder, so do not set an output mode here. The supervisor owns one process
# group containing D-Bus, wallpaper, notifications and the taskbar.

case "${WRDP_COMPOSITOR_PID:-}:${WRDP_COMPOSITOR_START_TICKS:-}" in
    *[!0-9:]*|:|*:)
        ;;
    *)
        if command -v dbus-run-session >/dev/null 2>&1 && command -v setsid >/dev/null 2>&1; then
            setsid /usr/lib/wrdp/wrdp-desktop-session \
                --compositor-pid "$WRDP_COMPOSITOR_PID" \
                --compositor-start-ticks "$WRDP_COMPOSITOR_START_TICKS" &
        fi
        ;;
esac
